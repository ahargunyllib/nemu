# Copy to .env on the VPS. `localhost` works for a local run (Caddy serves it with its own certificate).
MOODLE_DOMAIN=nemu-moodle.ahargunyllib.dev
POSTGRES_PASSWORD=
MOODLE_ADMIN_USERNAME=admin
MOODLE_ADMIN_PASSWORD=
# Password for the teacher account siti.aminah, created by setup-4a-uji.sh.
TEACHER_PASSWORD=
# wa-bot: the Nemu Service it hands photos to, and the shared secret (same value as the Worker's WA_BOT_SECRET).
NEMU_SERVER_URL=https://nemu-api.ahargunyllib.dev
WA_BOT_SECRET=

# Host without a public IP (README › Host without a public IP): the Cloudflare Tunnel token, the
# override that replaces Caddy, and the services auto-deploy.sh restarts (Caddy left out).
#TUNNEL_TOKEN=
#COMPOSE_FILE=compose.yaml:tunnel.yaml
#AUTO_DEPLOY_SERVICES=postgres moodle tunnel wa-bot
