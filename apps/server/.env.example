# Copy this file to apps/server/.env and replace the placeholder secrets.
NODE_ENV=development

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Set NEMU_RESPONDER=fixture to answer offline (docs/school-ai.md); no OpenRouter key needed.
NEMU_RESPONDER=ai
OPENROUTER_API_KEY=sk-or-v1-replace-me

# "Today" for a workspace without its own demo date.
NEMU_DEMO_DATE=2026-11-06

# Nemu v2.2 school models (docs/school-ai.md). Defaults are in .env.schema.
OPENROUTER_SCHOOL_READ_A_MODEL=google/gemini-4-hydrogen
OPENROUTER_SCHOOL_READ_B_MODEL=openai/gpt-6.1-terra
OPENROUTER_SCHOOL_REREAD_MODEL=openai/gpt-6.2-sol
OPENROUTER_SCHOOL_SCRIPT_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_SCHOOL_TEXT_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_STT_MODEL=microsoft/mai-transcribe-2
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2.1-flash
OPENROUTER_TTS_VOICE=id-ID-Harper:MAI-Voice-2.1-Flash
OPENROUTER_ZDR=false

# Encrypts WS-07 integration settings in D1. Generate with `openssl rand -base64 32`.
INTEGRATION_SECRETS_KEY=replace-with-a-random-secret-at-least-32-characters
