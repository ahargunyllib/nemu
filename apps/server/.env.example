# Copy this file to apps/server/.env and replace the placeholder secrets.
NODE_ENV=development

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Set NEMU_RESPONDER=fixture to answer from the Momen fixtures; no OpenRouter key needed.
NEMU_RESPONDER=ai
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_GENERATOR_MODEL=openai/gpt-6.1-sol
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Freezes "today" for the deterministic Moment 3 demo scenario.
NEMU_DEMO_DATE=2026-11-06
