# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# Comma-separated browser origins allowed to call the server (Demo App, Admin Workspace).
# @type=string(minLength=1)
CORS_ORIGIN=

# Who answers the school procedures: `ai` calls the OpenRouter models below, `fixture` answers
# offline from rules and synthetic fixtures (ADR-0001, docs/school-ai.md).
# @type=enum(ai, fixture)
NEMU_RESPONDER=ai

# @required=eq($NEMU_RESPONDER, ai)
# @type=string(minLength=1)
OPENROUTER_API_KEY=

# @type=string(pattern=^\\d{4}-\\d{2}-\\d{2}$)
NEMU_DEMO_DATE=2026-11-06

# --- Nemu v2.2 school (AlurSekolah) models; see docs/school-ai.md ---
# Photo Read A: structure + coordinates.
# @type=string(minLength=1)
OPENROUTER_SCHOOL_READ_A_MODEL=google/gemini-4-hydrogen

# Photo Read B: an independent second reader from a different model family.
# @type=string(minLength=1)
OPENROUTER_SCHOOL_READ_B_MODEL=openai/gpt-6.1-terra

# Crop re-read of doubtful cells.
# @type=string(minLength=1)
OPENROUTER_SCHOOL_REREAD_MODEL=google/gemini-4-hydrogen

# Help, grounded answers, slot extraction, Excel headers, procedure compile.
# @type=string(minLength=1)
OPENROUTER_SCHOOL_TEXT_MODEL=anthropic/claude-haiku-5.5

# @type=string(minLength=1)
OPENROUTER_STT_MODEL=microsoft/mai-transcribe-2

# Empty = no server TTS; the client speaks with the local OS voice.
# @required=false
OPENROUTER_TTS_MODEL=microsoft/mai-voice-2.1-flash

# @required=false
OPENROUTER_TTS_VOICE=id-ID-Harper:MAI-Voice-2.1-Flash

# true restricts every school call to zero-data-retention endpoints (Gemini is then unavailable).
# @type=enum(true, false)
OPENROUTER_ZDR=false

# Shared secret apps/wa-bot sends as a Bearer token (infra/README.md). Empty = the wa-bot endpoints refuse every call.
# Generate with `openssl rand -base64 32`.
# @required=false
# @type=string(minLength=32)
WA_BOT_SECRET=

# Encrypts the WS-07 integration settings (AlurSekolah key, Moodle token, …) stored in D1 (AES-GCM).
# Changing it makes every stored setting unreadable; re-enter them in WS-07. Empty = WS-07 can't save or read.
# Generate with `openssl rand -base64 32`.
# @required=false
# @type=string(minLength=32)
INTEGRATION_SECRETS_KEY=
