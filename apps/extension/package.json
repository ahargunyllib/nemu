{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "description": "Nemu Extension: the Nemu button on the school's allowed websites, for Chrome and Edge",
  "type": "module",
  "scripts": {
    "dev": "wxt --port 5555",
    "dev:edge": "wxt -b edge --port 5556",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "verify": "node scripts/verify.mjs",
    "verify:executor": "node scripts/verify-executor.mjs",
    "verify:f1-2": "node scripts/verify-f1-2.mjs",
    "verify:f2": "node scripts/verify-f2.mjs",
    "verify:f2-08": "node scripts/verify-f2-08.mjs",
    "verify:f3-1": "node scripts/verify-f3-1.mjs",
    "verify:f3-3": "node scripts/verify-f3-3.mjs",
    "verify:grade-photo": "node scripts/verify-grade-photo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@nemu/ai": "workspace:*",
    "@nemu/contracts": "workspace:*",
    "@nemu/ui": "workspace:*",
    "@orpc/client": "catalog:",
    "lucide-react": "^1.57.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^21.0.3",
    "playwright-core": "1.62.0",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
