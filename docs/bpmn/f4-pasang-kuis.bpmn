<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_F4_PasangKuis" targetNamespace="http://nemu.id/bpmn" exporter="Nemu">
  <bpmn:process id="Process_F4_PasangKuis" name="F4 Pasang Kuis" isExecutable="false">
    <bpmn:documentation>Alur Nemu memasang kuis di Moodle dari naskah guru (F4-03), lalu memeriksanya seperti yang dilihat siswa (F4-1). Tugas pengguna (userTask, grup "guru") dikerjakan guru; tugas layanan (serviceTask) adalah panggilan ke Nemu Service; tugas skrip (scriptTask) dikerjakan Nemu Extension di halaman, selalu dengan cara 1. Nemu tidak pernah mengirim formulir: setiap tombol simpan, impor, dan tambah ditekan guru (F0-08). Nemu tidak pernah menulis soal sendiri. Sumber: apps/extension/features/quiz-import dan features/quiz-check.</bpmn:documentation>
    <bpmn:startEvent id="Start_Perintah" name="Guru meminta Nemu memasukkan kuis dari naskah">
      <bpmn:documentation>Diketik atau diucapkan, misalnya "Nemu, masukkan kuis dari naskah ini, buka Senin 30 November, tutup Kamis 3 Desember."</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_HalamanKursus" name="Di halaman kursus Moodle?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_1a</bpmn:outgoing>
      <bpmn:outgoing>Flow_1b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_BukaKursus" name="Nemu meminta guru membuka halaman kursus">
      <bpmn:incoming>Flow_1b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_PilihNaskah" name="Guru memilih naskah" camunda:candidateGroups="guru">
      <bpmn:documentation>Tombol "Pilih naskah": PDF, Word, atau foto.</bpmn:documentation>
      <bpmn:incoming>Flow_1a</bpmn:incoming>
      <bpmn:incoming>Flow_3b</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BacaNaskah" name="Nemu Service membaca naskah">
      <bpmn:documentation>quizScriptRead (SchoolAi.readQuizScript): soal, pilihan, kunci, gambar, bagian kursus, dan tanggal dari kalimat guru menjadi draf kuis. Bagian yang tidak terbaca menjadi pertanyaan untuk guru.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_NaskahTerbaca" name="Naskah terbaca?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_3a</bpmn:outgoing>
      <bpmn:outgoing>Flow_3b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_AdaBagianKosong" name="Ada bagian yang belum terbaca?">
      <bpmn:incoming>Flow_3a</bpmn:incoming>
      <bpmn:outgoing>Flow_4a</bpmn:outgoing>
      <bpmn:outgoing>Flow_4b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_JawabBagian" name="Guru menjawab bagian yang belum terbaca" camunda:candidateGroups="guru">
      <bpmn:documentation>Satu Kartu Pilih per bagian (kata, kunci, gambar, bagian kursus), atau diketik dan diucapkan. "Nemu tidak mengisi soal sendiri." Soal yang dilewati tidak dimasukkan.</bpmn:documentation>
      <bpmn:incoming>Flow_4a</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_GabungBagian">
      <bpmn:incoming>Flow_4b</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_TanggalLengkap" name="Tanggal buka dan tutup lengkap dan berurutan?">
      <bpmn:documentation>Jam yang tidak disebut menjadi 00.00 (buka) atau 23.59 (tutup), dan Nemu mengatakannya.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_6a</bpmn:outgoing>
      <bpmn:outgoing>Flow_6b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SebutTanggal" name="Guru menyebut tanggalnya" camunda:candidateGroups="guru">
      <bpmn:incoming>Flow_6b</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_GuruMemeriksa" name="Guru memeriksa" camunda:candidateGroups="guru">
      <bpmn:documentation>Nemu menyebut waktu buka dan tutup; "Lihat ringkasan" memuat nama kuis, bagiannya, dan setiap soal. Guru menekan "Masukkan ke Moodle" bila sudah sesuai.</bpmn:documentation>
      <bpmn:incoming>Flow_6a</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Task_BuatXml" name="Nemu membuat berkas Moodle XML">
      <bpmn:documentation>moodleXml dari draf yang sudah diperiksa guru.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_IsiFormKuis" name="Nemu menambahkan kuis dan mengisi formulirnya">
      <bpmn:documentation>Mode Edit, "Tambahkan konten" di bagian itu › Aktivitas atau sumber daya › Semua › Kuis › Tambahkan; lalu Nama, Waktu Pengerjaan, dan kedua tanggal. Nemu menunjuk "Simpan dan tampilkan".</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_GuruMenekanSimpan" name="Guru menekan Simpan" camunda:candidateGroups="guru">
      <bpmn:documentation>Tombol Moodle "Simpan dan tampilkan".</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Task_BukaImpor" name="Nemu membuka Impor di bank soal kuis">
      <bpmn:documentation>Bank soal kuis itu › Soal-soal › Impor: Format XML Moodle, "Dapatkan kategori dari berkas" tidak dicentang, lalu berkas XML dijatuhkan ke pemilih berkas.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_BerkasDiterima" name="Moodle menerima berkas dalam 10 detik?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_12a</bpmn:outgoing>
      <bpmn:outgoing>Flow_12b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_SimpanUnduhan" name="Nemu menyimpan berkas di Unduhan">
      <bpmn:documentation>Nemu menunjuk "Pilih berkas …".</bpmn:documentation>
      <bpmn:incoming>Flow_12b</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_PilihBerkas" name="Guru memilih berkas XML" camunda:candidateGroups="guru">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_GabungBerkas">
      <bpmn:incoming>Flow_12a</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_GuruMenekanImpor" name="Guru menekan Impor" camunda:candidateGroups="guru">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ImporBerhasil" name="Impor berhasil?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_16a</bpmn:outgoing>
      <bpmn:outgoing>Flow_16b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_MoodleMenolak" name="Nemu menyampaikan pesan Moodle">
      <bpmn:documentation>"Moodle menolak berkasnya: …", lalu Catatan langkah.</bpmn:documentation>
      <bpmn:incoming>Flow_16b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_PilihSemuaSoal" name="Nemu memilih semua soal dari bank soal">
      <bpmn:documentation>Soal › Tambah › dari bank soal › Pilih semua. Nemu menunjuk "Tambahkan soal terpilih pada kuis".</bpmn:documentation>
      <bpmn:incoming>Flow_16a</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_GuruMenambahkanSoal" name="Guru menekan Tambahkan soal terpilih pada kuis" camunda:candidateGroups="guru">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Task_BacaKuis" name="Nemu membaca Setelan, Soal, dan Kuis">
      <bpmn:documentation>Pemeriksaan F4-1 pada kuis baru, dengan jumlah soal yang seharusnya. Hanya klik menu dan membaca; tidak ada yang diubah. Nemu menunjuk "Pratinjau kuis".</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_GuruPratinjau" name="Guru menekan Pratinjau kuis" camunda:candidateGroups="guru">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PeriksaKuis" name="Nemu memeriksa kuis seperti dilihat siswa">
      <bpmn:documentation>Aturan di Nemu Extension (gambar yang tidak muncul, soal yang semua jawabannya bernilai 0, jumlah soal, kelas, waktu buka dan tutup), lalu quizJudge (SchoolAi.judgeQuiz) di Nemu Service.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AdaMasalah" name="Ada masalah?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_21a</bpmn:outgoing>
      <bpmn:outgoing>Flow_21b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_TunjukMasalah" name="Nemu menunjuk setiap masalah">
      <bpmn:documentation>Satu Gelembung Jawab per masalah, menunjuk soalnya di pratinjau atau tombolnya di Navigasi kuis, dengan Berikutnya dan Selesai.</bpmn:documentation>
      <bpmn:incoming>Flow_21a</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_KuisSiap" name="Nemu menyampaikan kuis siap">
      <bpmn:documentation>Satu kalimat: "Kuis … sudah siap: 10 soal, dibuka … dan ditutup …"</bpmn:documentation>
      <bpmn:incoming>Flow_21b</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_GabungPeriksa">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_CatatanLangkah" name="Nemu menampilkan Catatan langkah">
      <bpmn:documentation>F0-14: langkah memasukkan kuis (termasuk cara berkas sampai ke Impor) dan langkah pemeriksaan. Setiap tindakan juga tercatat di log tindakan (WS-10).</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_KuisTerpasang" name="Kuis terpasang dan terperiksa">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Perintah" targetRef="Gateway_HalamanKursus" />
    <bpmn:sequenceFlow id="Flow_1a" name="Ya" sourceRef="Gateway_HalamanKursus" targetRef="Task_PilihNaskah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${halamanKursus == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1b" name="Tidak" sourceRef="Gateway_HalamanKursus" targetRef="End_BukaKursus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${halamanKursus == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_PilihNaskah" targetRef="Task_BacaNaskah" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_BacaNaskah" targetRef="Gateway_NaskahTerbaca" />
    <bpmn:sequenceFlow id="Flow_3a" name="Ya" sourceRef="Gateway_NaskahTerbaca" targetRef="Gateway_AdaBagianKosong">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${naskahTerbaca == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3b" name="Tidak: pilih lagi" sourceRef="Gateway_NaskahTerbaca" targetRef="Task_PilihNaskah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${naskahTerbaca == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4a" name="Ya" sourceRef="Gateway_AdaBagianKosong" targetRef="Task_JawabBagian">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adaBagianKosong == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4b" name="Tidak" sourceRef="Gateway_AdaBagianKosong" targetRef="Gateway_GabungBagian">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adaBagianKosong == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_JawabBagian" targetRef="Gateway_GabungBagian" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_GabungBagian" targetRef="Gateway_TanggalLengkap" />
    <bpmn:sequenceFlow id="Flow_6a" name="Ya" sourceRef="Gateway_TanggalLengkap" targetRef="Task_GuruMemeriksa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tanggalLengkap == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6b" name="Tidak: Nemu bertanya" sourceRef="Gateway_TanggalLengkap" targetRef="Task_SebutTanggal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tanggalLengkap == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SebutTanggal" targetRef="Gateway_TanggalLengkap" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_GuruMemeriksa" targetRef="Task_BuatXml" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_BuatXml" targetRef="Task_IsiFormKuis" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_IsiFormKuis" targetRef="Task_GuruMenekanSimpan" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_GuruMenekanSimpan" targetRef="Task_BukaImpor" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_BukaImpor" targetRef="Gateway_BerkasDiterima" />
    <bpmn:sequenceFlow id="Flow_12a" name="Ya" sourceRef="Gateway_BerkasDiterima" targetRef="Gateway_GabungBerkas">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${berkasDiterima == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12b" name="Tidak" sourceRef="Gateway_BerkasDiterima" targetRef="Task_SimpanUnduhan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${berkasDiterima == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SimpanUnduhan" targetRef="Task_PilihBerkas" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PilihBerkas" targetRef="Gateway_GabungBerkas" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_GabungBerkas" targetRef="Task_GuruMenekanImpor" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_GuruMenekanImpor" targetRef="Gateway_ImporBerhasil" />
    <bpmn:sequenceFlow id="Flow_16a" name="Ya" sourceRef="Gateway_ImporBerhasil" targetRef="Task_PilihSemuaSoal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${imporBerhasil == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16b" name="Tidak" sourceRef="Gateway_ImporBerhasil" targetRef="End_MoodleMenolak">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${imporBerhasil == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_PilihSemuaSoal" targetRef="Task_GuruMenambahkanSoal" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_GuruMenambahkanSoal" targetRef="Task_BacaKuis" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_BacaKuis" targetRef="Task_GuruPratinjau" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_GuruPratinjau" targetRef="Task_PeriksaKuis" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_PeriksaKuis" targetRef="Gateway_AdaMasalah" />
    <bpmn:sequenceFlow id="Flow_21a" name="Ya" sourceRef="Gateway_AdaMasalah" targetRef="Task_TunjukMasalah">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adaMasalah == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21b" name="Tidak" sourceRef="Gateway_AdaMasalah" targetRef="Task_KuisSiap">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${adaMasalah == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_TunjukMasalah" targetRef="Gateway_GabungPeriksa" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_KuisSiap" targetRef="Gateway_GabungPeriksa" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_GabungPeriksa" targetRef="Task_CatatanLangkah" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_CatatanLangkah" targetRef="End_KuisTerpasang" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_F4_PasangKuis">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_F4_PasangKuis" bpmnElement="Process_F4_PasangKuis">
      <bpmndi:BPMNShape id="Start_Perintah_di" bpmnElement="Start_Perintah">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HalamanKursus_di" bpmnElement="Gateway_HalamanKursus" isMarkerVisible="true">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PilihNaskah_di" bpmnElement="Task_PilihNaskah">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BacaNaskah_di" bpmnElement="Task_BacaNaskah">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_NaskahTerbaca_di" bpmnElement="Gateway_NaskahTerbaca" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AdaBagianKosong_di" bpmnElement="Gateway_AdaBagianKosong" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_JawabBagian_di" bpmnElement="Task_JawabBagian">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GabungBagian_di" bpmnElement="Gateway_GabungBagian" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TanggalLengkap_di" bpmnElement="Gateway_TanggalLengkap" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GuruMemeriksa_di" bpmnElement="Task_GuruMemeriksa">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
