{
  "name": "@nemu/ai",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chunking": {
      "types": "./scripts/knowledge-chunking.d.mts",
      "import": "./scripts/knowledge-chunking.mjs"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "test": "tsc -b && node --test dist/school/*.test.js dist/school/grades/*.test.js dist/school/bpmn/*.test.js dist/school/quiz/*.test.js scripts/rule-sources.test.mjs",
    "eval:school": "tsc -b && node scripts/evaluate-school.mjs",
    "eval:f3-1": "tsc -b && node scripts/evaluate-f3-1.mjs"
  },
  "dependencies": {
    "@bpmn-io/feelin": "7.0.0",
    "@nemu/contracts": "workspace:*",
    "bpmn-auto-layout": "1.3.0",
    "bpmn-moddle": "10.3.1",
    "camunda-bpmn-moddle": "8.0.2",
    "jexl": "2.3.0",
    "munkres": "2.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nemu/config": "workspace:*",
    "@types/jexl": "2.3.4",
    "typescript": "catalog:"
  }
}
