{
  "name": "@nemu/ai",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chunking": {
      "types": "./scripts/knowledge-chunking.d.mts",
      "import": "./scripts/knowledge-chunking.mjs"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "data:generate": "node scripts/generate-demo-data.mjs",
    "seed:generate": "node scripts/generate-workspace-seed.mjs",
    "build": "node scripts/generate-demo-data.mjs && tsc -b",
    "check-types": "tsc -b",
    "test": "node scripts/generate-demo-data.mjs && tsc -b && node --test dist/school/*.test.js dist/school/grades/*.test.js dist/school/bpmn/*.test.js dist/desktop/*.test.js dist/index.test.js dist/claim-tools.test.js dist/claim-workflows.test.js dist/claim-workflows.pipeline.test.js scripts/demo-data-lib.test.mjs scripts/moment-validators.test.mjs scripts/claim-validators.test.mjs scripts/workspace-seed-lib.test.mjs scripts/telco-workspace-seed.test.mjs scripts/evaluation-utils.test.mjs scripts/retrieval-evaluation.test.mjs scripts/rule-sources.test.mjs",
    "eval": "node scripts/generate-demo-data.mjs && tsc -b && node scripts/evaluate.mjs",
    "eval:offline": "node scripts/generate-demo-data.mjs && tsc -b && node scripts/evaluate.mjs --offline",
    "eval:live": "node scripts/generate-demo-data.mjs && tsc -b && node scripts/evaluate.mjs --live",
    "eval:live:failed": "node scripts/generate-demo-data.mjs && tsc -b && node scripts/evaluate.mjs --live --moments=2,3",
    "eval:school": "tsc -b && node scripts/evaluate-school.mjs"
  },
  "dependencies": {
    "@bpmn-io/feelin": "7.0.0",
    "@nemu/contracts": "workspace:*",
    "bpmn-moddle": "10.3.1",
    "camunda-bpmn-moddle": "8.0.2",
    "jexl": "2.3.0",
    "munkres": "2.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nemu/config": "workspace:*",
    "@types/jexl": "2.3.4",
    "typescript": "catalog:"
  }
}
