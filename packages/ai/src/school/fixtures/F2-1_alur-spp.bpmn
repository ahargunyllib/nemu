<?xml version="1.0" encoding="UTF-8"?>
<!--
  SALINAN dari gambar BPMN proses SPP yang dikirim mentor Javan (bukan file asli).
  Disusun ulang tim Nemu untuk data uji F2-1 (nilai tidak muncul di aplikasi orang tua).
  Label dibiarkan sama dengan gambar (bahasa Inggris). ID elemen dibuat tim Nemu dan dipakai
  di F2-1_pertanyaan-dan-kunci.csv kolom elemen_bpmn_sumber.
  GANTI file ini dengan .bpmn asli bila Javan memberikannya, lalu sesuaikan ID di kunci jawaban.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_SPP" targetNamespace="https://nemu.example/bpmn/spp"
  exporter="Tim Nemu (salinan manual)" exporterVersion="1.0">

  <bpmn:message id="Msg_PaidInCash" name="Paid in Cash" />
  <bpmn:message id="Msg_PaymentSent" name="Payment Sent" />

  <bpmn:collaboration id="Collab_SPP">
    <bpmn:participant id="Pool_School" name="Elementary School" processRef="Process_SPP" />
    <bpmn:participant id="Pool_DOKU" name="DOKU Payment Gateway" />
    <bpmn:messageFlow id="MsgFlow_PaymentSent" name="VA / QRIS" sourceRef="Pool_DOKU" targetRef="Catch_PaymentSent" />
  </bpmn:collaboration>

  <bpmn:process id="Process_SPP" name="SPP Payment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SPP">
      <bpmn:lane id="Lane_Parent" name="Parent">
        <bpmn:flowNodeRef>Start_InvoiceIssued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_DueDateReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_PaidInCash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_IsRegularInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LockGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_GradesLocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NotRegularInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_PaymentSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInvoices</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_InvoiceType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdatePartiallyPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvoicesPartiallyPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnlockGrades</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateFullyPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_InvoicePaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditESaku</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_InvoiceIssued" name="Payment Invoice Issued">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_PayInvoice" name="Pay Invoice">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Timer non-interrupting: tagihan tetap bisa dibayar setelah jatuh tempo -->
    <bpmn:boundaryEvent id="Timer_DueDateReached" name="Due Date Reached" attachedToRef="Task_PayInvoice" cancelActivity="false">
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_DueDate">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${invoice.dueDate}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="Boundary_PaidInCash" name="Paid in Cash" attachedToRef="Task_PayInvoice">
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_PaidInCash" messageRef="Msg_PaidInCash" />
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gw_IsRegularInvoice" name="Is Regular Invoice?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_LockGrades" name="Lock Student Grades">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_GradesLocked" name="Grades Locked">
      <bpmn:incoming>Flow_06</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_NotRegularInvoice" name="Not a Regular Invoice">
      <bpmn:incoming>Flow_05</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateCatchEvent id="Catch_PaymentSent" name="Payment Sent">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_PaymentSent" messageRef="Msg_PaymentSent" />
    </bpmn:intermediateCatchEvent>

    <bpmn:serviceTask id="Task_CheckInvoices" name="Check Invoices">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_InvoiceType" name="Invoice Type?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_UpdatePartiallyPaid" name="Update Status: Partially Paid">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_InvoicesPartiallyPaid" name="Invoices Partially Paid">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_UnlockGrades" name="Unlock Student Grades">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_UpdateFullyPaid" name="Update Status: Fully Paid">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_InvoicePaid" name="Invoice Paid">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_CreditESaku" name="Credit E-Saku Balance">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_InvoiceIssued" targetRef="Task_PayInvoice" />
    <bpmn:sequenceFlow id="Flow_02" name="Pay via VA / QRIS" sourceRef="Task_PayInvoice" targetRef="Catch_PaymentSent" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Timer_DueDateReached" targetRef="Gw_IsRegularInvoice" />
    <bpmn:sequenceFlow id="Flow_04" name="Yes" sourceRef="Gw_IsRegularInvoice" targetRef="Task_LockGrades" />
    <bpmn:sequenceFlow id="Flow_05" name="No" sourceRef="Gw_IsRegularInvoice" targetRef="End_NotRegularInvoice" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_LockGrades" targetRef="End_GradesLocked" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Catch_PaymentSent" targetRef="Task_CheckInvoices" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Boundary_PaidInCash" targetRef="Task_CheckInvoices" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_CheckInvoices" targetRef="Gw_InvoiceType" />
    <bpmn:sequenceFlow id="Flow_10" name="Regular, Overdue Left" sourceRef="Gw_InvoiceType" targetRef="Task_UpdatePartiallyPaid" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_UpdatePartiallyPaid" targetRef="End_InvoicesPartiallyPaid" />
    <bpmn:sequenceFlow id="Flow_12" name="Regular, None Overdue" sourceRef="Gw_InvoiceType" targetRef="Task_UnlockGrades" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_UnlockGrades" targetRef="Task_UpdateFullyPaid" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_UpdateFullyPaid" targetRef="End_InvoicePaid" />
    <bpmn:sequenceFlow id="Flow_15" name="Other Invoice" sourceRef="Gw_InvoiceType" targetRef="Task_UpdateFullyPaid" />
    <bpmn:sequenceFlow id="Flow_16" name="E-Saku Top-up" sourceRef="Gw_InvoiceType" targetRef="Task_CreditESaku" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CreditESaku" targetRef="Task_UpdateFullyPaid" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_SPP">
    <bpmndi:BPMNPlane id="Plane_SPP" bpmnElement="Collab_SPP">
      <bpmndi:BPMNShape id="Pool_School_di" bpmnElement="Pool_School" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="1380" height="580" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Parent_di" bpmnElement="Lane_Parent" isHorizontal="true">
        <dc:Bounds x="180" y="60" width="1350" height="580" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_DOKU_di" bpmnElement="Pool_DOKU" isHorizontal="true">
        <dc:Bounds x="150" y="700" width="1380" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_InvoiceIssued_di" bpmnElement="Start_InvoiceIssued">
        <dc:Bounds x="222" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="200" y="365" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PayInvoice_di" bpmnElement="Task_PayInvoice">
        <dc:Bounds x="300" y="300" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_DueDateReached_di" bpmnElement="Timer_DueDateReached">
        <dc:Bounds x="352" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="276" y="250" width="70" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_PaidInCash_di" bpmnElement="Boundary_PaidInCash">
        <dc:Bounds x="352" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="285" y="402" width="64" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_IsRegularInvoice_di" bpmnElement="Gw_IsRegularInvoice" isMarkerVisible="true">
        <dc:Bounds x="455" y="165" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="392" y="222" width="60" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LockGrades_di" bpmnElement="Task_LockGrades">
        <dc:Bounds x="570" y="150" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_GradesLocked_di" bpmnElement="End_GradesLocked">
        <dc:Bounds x="772" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="755" y="215" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotRegularInvoice_di" bpmnElement="End_NotRegularInvoice">
        <dc:Bounds x="462" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="505" y="86" width="104" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_PaymentSent_di" bpmnElement="Catch_PaymentSent">
        <dc:Bounds x="532" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="466" y="364" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckInvoices_di" bpmnElement="Task_CheckInvoices">
        <dc:Bounds x="630" y="300" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_InvoiceType_di" bpmnElement="Gw_InvoiceType" isMarkerVisible="true">
        <dc:Bounds x="825" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="760" y="292" width="68" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdatePartiallyPaid_di" bpmnElement="Task_UpdatePartiallyPaid">
        <dc:Bounds x="1000" y="150" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_InvoicesPartiallyPaid_di" bpmnElement="End_InvoicesPartiallyPaid">
        <dc:Bounds x="1232" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1205" y="215" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UnlockGrades_di" bpmnElement="Task_UnlockGrades">
        <dc:Bounds x="1000" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateFullyPaid_di" bpmnElement="Task_UpdateFullyPaid">
        <dc:Bounds x="1220" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_InvoicePaid_di" bpmnElement="End_InvoicePaid">
        <dc:Bounds x="1442" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1430" y="365" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreditESaku_di" bpmnElement="Task_CreditESaku">
        <dc:Bounds x="1000" y="520" width="160" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="258" y="340" /><di:waypoint x="300" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="440" y="340" /><di:waypoint x="532" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="445" y="322" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="370" y="282" /><di:waypoint x="370" y="190" /><di:waypoint x="455" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="505" y="190" /><di:waypoint x="570" y="190" />
        <bpmndi:BPMNLabel><dc:Bounds x="528" y="172" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="480" y="165" /><di:waypoint x="480" y="118" />
        <bpmndi:BPMNLabel><dc:Bounds x="486" y="135" width="16" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="710" y="190" /><di:waypoint x="772" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="568" y="340" /><di:waypoint x="630" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="370" y="398" /><di:waypoint x="370" y="460" /><di:waypoint x="700" y="460" /><di:waypoint x="700" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="770" y="340" /><di:waypoint x="825" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="850" y="315" /><di:waypoint x="850" y="190" /><di:waypoint x="1000" y="190" />
        <bpmndi:BPMNLabel><dc:Bounds x="858" y="170" width="140" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1160" y="190" /><di:waypoint x="1232" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="875" y="340" /><di:waypoint x="1000" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="872" y="320" width="128" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1160" y="340" /><di:waypoint x="1220" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1380" y="340" /><di:waypoint x="1442" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="850" y="365" /><di:waypoint x="850" y="440" /><di:waypoint x="1280" y="440" /><di:waypoint x="1280" y="380" />
        <bpmndi:BPMNLabel><dc:Bounds x="1000" y="422" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="850" y="365" /><di:waypoint x="850" y="560" /><di:waypoint x="1000" y="560" />
        <bpmndi:BPMNLabel><dc:Bounds x="870" y="542" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <di:waypoint x="1160" y="560" /><di:waypoint x="1320" y="560" /><di:waypoint x="1320" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_PaymentSent_di" bpmnElement="MsgFlow_PaymentSent">
        <di:waypoint x="550" y="700" /><di:waypoint x="550" y="358" />
        <bpmndi:BPMNLabel><dc:Bounds x="556" y="600" width="56" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
