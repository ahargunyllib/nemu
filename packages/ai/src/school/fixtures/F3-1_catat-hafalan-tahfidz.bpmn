<?xml version="1.0" encoding="UTF-8"?>
<!-- Contoh BPMN uji Nemu (sintetis). Mengikuti form asli AlurSekolah menu Al-Quran > Tahfidz.
     Ganti dengan BPMN asli "Student Activity Input" bila Javan memberikannya. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Tahfidz" targetNamespace="https://nemu.example/bpmn">
  <bpmn:collaboration id="Collab_Tahfidz">
    <bpmn:participant id="Pool_Sekolah" name="Sekolah" processRef="Proses_CatatHafalanTahfidz" />
  </bpmn:collaboration>
  <bpmn:process id="Proses_CatatHafalanTahfidz" name="Catat Hafalan Tahfidz" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Guru" name="Guru">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PilihJenis</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Jenis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Setoran</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Ujian</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Gabung</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistem" name="Sistem AlurSekolah">
        <bpmn:flowNodeRef>Task_Hitung</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Tampil</bpmn:flowNodeRef><bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Guru ingin mencatat hafalan" />
    <bpmn:userTask id="Task_PilihJenis" name="Pilih jenis catatan" camunda:assignee="guru">
      <bpmn:documentation>Menu Al-Quran, lalu Tahfidz. Pilih kelas dan jenis catatan: Setoran (satu kelas sekaligus) atau Ujian (satu murid per form).</bpmn:documentation>
      <bpmn:extensionElements><camunda:formData>
        <camunda:formField id="kelas" label="Kelas" type="string" />
        <camunda:formField id="jenis_catatan" label="Jenis catatan Tahfidz" type="enum"><camunda:value id="Setoran" name="Setoran" /><camunda:value id="Ujian" name="Ujian" /></camunda:formField>
      </camunda:formData></bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Jenis" name="Jenis catatan?" />
    <bpmn:userTask id="Task_Setoran" name="Isi setoran satu kelas" camunda:assignee="guru">
      <bpmn:documentation>Tombol Setoran baru. Diisi per murid; baris murid yang tidak setor dibiarkan kosong. Ayat dikosongkan berarti semua ayat surah. Skor dikosongkan berarti belum dinilai. Bobot: Fashohah 30%, Tartil 30%, Tajwid 30%, Adab 10%. Selesai saat guru menekan Simpan setoran; hasil langsung terlihat orang tua.</bpmn:documentation>
      <bpmn:extensionElements><camunda:formData>
        <camunda:formField id="tanggal_setoran" label="Tanggal setoran" type="date" />
        <camunda:formField id="surah" label="Surah" type="string" />
        <camunda:formField id="ayat_dari" label="Dari ayat" type="long" />
        <camunda:formField id="ayat_sampai" label="Sampai ayat" type="long" />
        <camunda:formField id="fashohah" label="Fashohah" type="long" />
        <camunda:formField id="tartil" label="Tartil" type="long" />
        <camunda:formField id="tajwid" label="Tajwid" type="long" />
        <camunda:formField id="adab" label="Adab" type="long" />
        <camunda:formField id="catatan" label="Catatan" type="string" />
      </camunda:formData></bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ujian" name="Isi ujian per murid" camunda:assignee="guru">
      <bpmn:documentation>Tombol Ujian baru. Satu murid per form. Jenis ujian dikelola di pengaturan modul Al-Quran. Isi skor 0 sampai 100 tiap aspek; nilai dan huruf dihitung otomatis. Selesai saat guru menekan Simpan ujian.</bpmn:documentation>
      <bpmn:extensionElements><camunda:formData>
        <camunda:formField id="murid" label="Murid" type="string" />
        <camunda:formField id="jenis_ujian" label="Jenis ujian" type="string" />
        <camunda:formField id="tanggal_ujian" label="Tanggal ujian" type="date" />
        <camunda:formField id="fashohah_ujian" label="Fashohah" type="long" />
        <camunda:formField id="tartil_ujian" label="Tartil" type="long" />
        <camunda:formField id="tajwid_ujian" label="Tajwid" type="long" />
        <camunda:formField id="adab_ujian" label="Adab" type="long" />
      </camunda:formData></bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Gabung" />
    <bpmn:serviceTask id="Task_Hitung" name="Hitung nilai dan huruf" camunda:type="external" camunda:topic="hitung-nilai-tahfidz" />
    <bpmn:serviceTask id="Task_Tampil" name="Tampilkan di aplikasi orang tua" camunda:type="external" camunda:topic="publikasi-ortu" />
    <bpmn:endEvent id="End_1" name="Hafalan tercatat" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_PilihJenis" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_PilihJenis" targetRef="Gw_Jenis" />
    <bpmn:sequenceFlow id="F3" name="Setoran" sourceRef="Gw_Jenis" targetRef="Task_Setoran"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${jenis_catatan == 'Setoran'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" name="Ujian" sourceRef="Gw_Jenis" targetRef="Task_Ujian"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${jenis_catatan == 'Ujian'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Setoran" targetRef="Gw_Gabung" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Ujian" targetRef="Gw_Gabung" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Gabung" targetRef="Task_Hitung" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Hitung" targetRef="Task_Tampil" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Tampil" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Tahfidz">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool_Sekolah" isHorizontal="true"><dc:Bounds x="100" y="60" width="1060" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneGuru_di" bpmnElement="Lane_Guru" isHorizontal="true"><dc:Bounds x="130" y="60" width="1030" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneSistem_di" bpmnElement="Lane_Sistem" isHorizontal="true"><dc:Bounds x="130" y="320" width="1030" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start_1"><dc:Bounds x="172" y="172" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PilihJenis_di" bpmnElement="Task_PilihJenis"><dc:Bounds x="250" y="150" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwJenis_di" bpmnElement="Gw_Jenis" isMarkerVisible="true"><dc:Bounds x="415" y="165" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Setoran_di" bpmnElement="Task_Setoran"><dc:Bounds x="520" y="90" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ujian_di" bpmnElement="Task_Ujian"><dc:Bounds x="520" y="215" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwGabung_di" bpmnElement="Gw_Gabung" isMarkerVisible="true"><dc:Bounds x="715" y="165" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hitung_di" bpmnElement="Task_Hitung"><dc:Bounds x="690" y="360" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tampil_di" bpmnElement="Task_Tampil"><dc:Bounds x="860" y="360" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End_1"><dc:Bounds x="1062" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="208" y="190" /><di:waypoint x="250" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="370" y="190" /><di:waypoint x="415" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="440" y="165" /><di:waypoint x="440" y="130" /><di:waypoint x="520" y="130" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="440" y="215" /><di:waypoint x="440" y="255" /><di:waypoint x="520" y="255" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="660" y="130" /><di:waypoint x="740" y="130" /><di:waypoint x="740" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="660" y="255" /><di:waypoint x="740" y="255" /><di:waypoint x="740" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="740" y="215" /><di:waypoint x="740" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="810" y="400" /><di:waypoint x="860" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1000" y="400" /><di:waypoint x="1062" y="400" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
