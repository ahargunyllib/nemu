{
  "name": "nemu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "test": "vp run -r test",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "dev:server": "vp run --filter hono dev:bare",
    "db:generate": "vp run --filter @nemu/db db:generate",
    "deploy": "vp run --filter @nemu/infra deploy",
    "destroy": "vp run --filter @nemu/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@nemu/config": "workspace:*",
    "@types/node": "^26.4.1",
    "rolldown": "1.2.13",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "1.1.0"
  },
  "packageManager": "pnpm@12.3.4"
}
